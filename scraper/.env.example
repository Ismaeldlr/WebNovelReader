# Shared PostgreSQL database.
# SCRAPER_DATABASE_URL is an optional scraper-only override.
SCRAPER_DATABASE_URL=postgresql://postgres:password@localhost:5432/webnovel_hub

# By default, scraper/config.py builds the connection URL from the same DB_* values
# used by the Node server.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webnovel_hub
DB_USER=postgres
DB_PASSWORD=password

# Scraper behavior.
SCRAPER_POLL_INTERVAL=5
REQUEST_DELAY=2
HEADLESS=true
MAX_RETRIES=3

# The Node API starts the worker automatically by default. Set this to false
# when the worker is managed separately.
SCRAPER_AUTOSTART=true

# Absolute path to server/public/covers.
COVERS_DIR=C:\absolute\path\to\Webnovel_Hub\server\public\covers
